# Bolo Dukaan settings. Copy this file to .env (start.bat does it for you) and fill in the keys.
# Restart the server after changing anything here. Keys stay on the server and are never sent to browsers.

# ---- Sarvam AI (preferred for voice, Kannada speech, chat and menu reading) ----
# Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Speech-to-text model (saaras:v4 is the current one; it accepts the browser's audio directly)
SARVAM_STT_MODEL=saaras:v4
# Text-to-speech model and voice (bulbul:v3 voices include kavya, shubh, priya, ritu, aditya ...)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=kavya
# Chat model used to understand orders and read menus
SARVAM_LLM_MODEL=sarvam-105b
# Seconds to wait for a Sarvam reply before showing a friendly fallback
SARVAM_TIMEOUT=15

# ---- Gemini (backup AI: used if Sarvam is missing or fails) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# ---- Google sign-in for owners (optional) ----
# console.cloud.google.com -> APIs & Services -> Credentials -> Create credentials -> OAuth client ID -> Web application.
# Authorized JavaScript origins: http://localhost:8001 (and your https ngrok link). Paste the Client ID here.
GOOGLE_CLIENT_ID=

# ---- Cashfree payment links ----
# Sandbox keys: https://merchant.cashfree.com  ->  Developers  ->  API Keys (Test mode)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ---- Public link for phones ----
# Leave empty: the app finds a running ngrok by itself.
# Or paste your HTTPS ngrok link, e.g. https://abcd-1234.ngrok-free.app
PUBLIC_URL=

# ---- Feature switches (true/false). All are OFF unless set here. ----
# If one breaks during the demo, set it to false and restart: the rest of the site keeps working.
# See SARVAM_FEATURES.md for what each one does and how to demo it.
# Kannada voice alerts on the cashier dashboard
FEATURE_KANNADA_ALERTS=true
# Allow Gemini's voice when Sarvam isn't available
FEATURE_GEMINI_TTS=true
# Mic button at the table: order by speaking
FEATURE_VOICE_ORDER=true
# Menu photo / PDF -> draft menu for the owner to check
FEATURE_MENU_PHOTO=true
# "Rs 800, dinner for 4" -> a basket built from menu prices (no AI)
FEATURE_BUDGET_ORDER=true
# Voice "call the waiter" / "get the bill" (needs FEATURE_VOICE_ORDER)
FEATURE_VOICE_ACTIONS=true
# Live quiz between tables; winning table gets a free tea at Rs 0
FEATURE_TABLE_QUIZ=true

# ---- Upgrades (all off unless set to true) ----
# A1: today's sales strip + bill list on the dashboard (verified payments only)
FEATURE_SALES_SUMMARY=true
# A2: split the bill equally or by items, one UPI link per person (needs Cashfree)
FEATURE_SPLIT_BILL=true
# A3: owner voice assistant on the dashboard ("aaj ka collection?", "free table 4") (needs Sarvam or Gemini)
FEATURE_OWNER_VOICE=true
# B: supermarket mode (choose "Supermarket" at sign-up): products, store QR, direct order, pick & pack
FEATURE_SUPERMARKET=true
# B2: AI meal planner in the supermarket shop (needs FEATURE_SUPERMARKET)
FEATURE_MEAL_PLANNER=true
# Approx. calories / protein / carbs / fat on restaurant menu dishes and recipes (IFCT/NIN data)
FEATURE_NUTRITION=true
# Real food & grocery photos from Wikimedia Commons (free licences, credited at /credits)
FEATURE_PHOTOS=true

# ---- Restaurant upgrades (1 and 6 are on unless set to false; the rest are off unless true) ----
# 1: guests can browse the menu before the waiter approves the table (ordering still waits for approval)
FEATURE_MENU_PREVIEW=true
# 6: chairs per table (setup, QR cards, dashboard, waiter, kitchen, 3D floor)
FEATURE_SEATS=true
# 4: tap a dish for photo, description, spice, allergens and nutrition (owner-entered or computed, never guessed)
FEATURE_DISH_DETAILS=true
# 3: big-screen kitchen display at a secret link, speaks new accepted orders in Kannada
FEATURE_KITCHEN_TV=true
# 2: waiter accounts (username + PIN) and the mobile waiter portal
FEATURE_STAFF=true
# 5: "Play with my table": a private trivia room with its own QR
FEATURE_GAME_ROOMS=true
# 7: optional floor plan: upload a blueprint, place tables; the 3D floor follows it
FEATURE_FLOOR_PLAN=true
# Merge two tables for a big group (owner and waiters)
FEATURE_MERGE_TABLES=true
# Daily report: CSV download + printable page (Save as PDF)
FEATURE_DAILY_REPORT=true

# Optional: fixed secret for login cookies (otherwise one is made in data/secret.key)
SECRET_KEY=
